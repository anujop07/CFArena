# ═══════════════════════════════════════════════════════════════════════════════
# CF Arena — Root Docker Compose Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════

# Docker Hub Image Configuration
DOCKER_HUB_USERNAME=yourdockerhubusername
IMAGE_TAG=latest

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/cf_duel_db
MONGODB_DATABASE=cf_duel_db

# Security & Application Settings
JWT_SECRET=your_jwt_super_secret_key_change_in_production_min_256_bits
FRONTEND_URL=http://localhost:5173
BOOTSTRAP_SECRET=your_bootstrap_secret_key

# Google OAuth2 Configuration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# Codeforces OAuth 2.0 / OpenID Connect (OIDC) Configuration
CODEFORCES_CLIENT_ID=your_codeforces_oidc_client_id
CODEFORCES_CLIENT_SECRET=your_codeforces_oidc_client_secret
CODEFORCES_REDIRECT_URI=http://localhost:8080/api/auth/codeforces/callback
CODEFORCES_AUTH_URL=https://codeforces.com/oauth/authorize
CODEFORCES_TOKEN_URL=https://codeforces.com/oauth/token
CODEFORCES_ISSUER=https://codeforces.com
CODEFORCES_JWKS_URL=https://codeforces.com/oauth/jwks
